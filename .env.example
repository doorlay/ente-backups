# ---- Ente sync (required) ----

# Directory where photos are exported to
EXPORT_DIR=/data/backups

# Path to the Ente CLI secrets file
SECRETS_PATH=/srv/backups/ente-secrets/credentials

# Include hidden media in the export
INCLUDE_HIDDEN=false

# Optional: export only specific albums, specified via comma-separated names
# (e.g. ALBUMS=Camera,Trips 2025,Favorites). If left empty, all albums will be
# exported.
ALBUMS=

# ---- Restic S3 backup (optional) ----
# S3 bucket for restic (e.g. s3:s3.amazonaws.com/my-bucket)
RESTIC_REPOSITORY=

# Encryption password for the restic repository
RESTIC_PASSWORD=

# AWS credentials for S3 access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- ntfy.sh (optional) ----
# ntfy.sh topic name (e.g. my-ente-backups) 
NTFY_TOPIC=
